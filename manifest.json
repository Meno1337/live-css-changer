{
  "manifest_version": 3,
  "name": "Live CSS Editor",
  "version": "1.3",
  "description": "Live CSS Editor for editing website styles",
  "permissions": [
    "scripting",
    "activeTab",
    "storage",
    "contextMenus",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Live CSS Editor"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}